{
  "mcpServers": {
    "vault-search": {
      "command": "/opt/homebrew/bin/uv",
      "args": [
        "--directory",
        "/Users/stephenelms/Dev/index-embedding-llm",
        "run",
        "obsidian-rag-mcp"
      ]
    },
    "mcp-obsidian": {
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "mcp-obsidian"
      ],
      "env": {
        "OBSIDIAN_API_KEY": "$OBSIDIAN_API_KEY",
        "OBSIDIAN_HOST": "$OBSIDIAN_HOST",
        "OBSIDIAN_PORT": "$OBSIDIAN_PORT"
      }
    }
  }
}
